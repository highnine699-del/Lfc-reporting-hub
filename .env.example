# ─────────────────────────────────────────────────────────────────────────────
# LFC Reporting Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Paystack (OPTIONAL) ───────────────────────────────────────────────────────
# Required only when you want real payment processing.
# Without this key the app runs in test/simulation mode.
# Get your key from: https://dashboard.paystack.com/#/settings/developer

VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App URL (OPTIONAL) ────────────────────────────────────────────────────────
# Used for auth redirect URLs. Defaults work fine for local dev.
# Set this to your production domain when deploying.

VITE_APP_URL=https://lfc-reporting-hub.vercel.app
